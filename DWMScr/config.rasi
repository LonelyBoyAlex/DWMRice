@import "~/.cache/hellwal/rofi.rasi"
* {
 /*
    active-background: #3d3e57;
    active-foreground: @foreground;
    normal-background: transparent;
    normal-foreground: @foreground;
    urgent-background: #6a6a6a;
    urgent-foreground: @foreground;

    alternate-active-background: @background;
    alternate-active-foreground: @foreground;
    alternate-normal-background: transparent;
    alternate-normal-foreground: @foreground;
    alternate-urgent-background: @background;
    alternate-urgent-foreground: @foreground;

    selected-active-background: #6A6a6a;
    selected-active-foreground: @foreground;
    selected-normal-background: #B5b5b5;
    selected-normal-foreground: @foreground;
    selected-urgent-background: #8D8d8d;
    selected-urgent-foreground: @foreground;
    bgcol: #3d3e57;
    borcol: #fad7ff;

*/

    font: "Iosevka Nerd Font Propo 13";
}


#window {
    background-color: transparent;
    padding: 2ch;
    width:27%;
    height:70%;
    text-align: center;
    border: 2px;
    border-color:@borcol;
    border-radius:12px;
}

#mainbox {
    padding: 0px;
    border-radius:12px;
}

#message {
    border: 2px 0px 0px;
    border-color: @border-color;
    padding: 1px;
}

#textbox {
    text-color: @foreground;
}

#inputbar {
    background: @bgcol;
    background-color: @bgcol;
    border: none;
    border-radius:12px;
    border-color:transparent;
    children:   [ prompt,textbox-prompt-colon,entry,case-indicator ];
}

#textbox-prompt-colon {
    expand: false;
    str: "->";
    margin: 0px 0.1em 0em 0em;
    padding: 10px 10px 10px 0px;
    text-color: #1e1e2e;
    background-color: #e8c2ff;
    text-color: @selected-active-background;
    background-color:@selected-normal-background;
}

#listview {
    /*background-color: #3c3d56;*/
    background-color: transparent;
    fixed-height: 0;
    border-radius: 12px;
    border-color: @border-color;
    spacing: 8px;
    scrollbar: true;
    padding: 20px 2px 2px 2px;
}

#element {
    background:transparent;
    background-color: transparent;
    padding: 8px 4px 8px 32px;
    font-size:16px;
    border-radius:12px;

}

#element-text, element-icon {
    background-color: inherit;
    text-color:       inherit;
    font-size:16px;
    text-size:16px;
}

#element.normal.normal {
    /*background-color: @normal-background;
    text-color: #ccd5f3;
    */
    background:transparent;
}

#element.normal.urgent {
    background-color: @urgent-background;
    text-color: @urgent-foreground;
}

#element.normal.active {
    background-color: @active-background;
    text-color: @active-foreground;
}

#element.selected.normal {
    /*background-color: #e6c1ff; //picker here
    text-color: #1e1e2d;
    border-color:#f3cfff;*/
    text-color: @selected-active-background;
    background-color:@selected-normal-background;
    border:none;
    border-radius:12px;
}

#element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color: @selected-urgent-foreground;
}

#element.selected.active {
    background-color: @selected-active-background;
    text-color: @selected-active-foreground;
}

#element.alternate.normal {
    background-color: @alternate-normal-background;
}

#element.alternate.urgent {
    background-color: @alternate-urgent-background;
    text-color: @alternate-urgent-foreground;
}

#element.alternate.active {
    background-color: @alternate-active-background;
    text-color: @alternate-active-foreground;
}

#scrollbar {
    width: 2px;
    border: 0;
    handle-width: 2px;
    padding: 0;
}

#sidebar {
    border: 2px 0px 0px;
    border-color: @border-color;
}

#button {
    text-color: @normal-foreground;
}

#button.selected {
    background-color: @selected-normal-background;
    text-color: @selected-normal-foreground;
}

#inputbar {
    spacing: 0;
    text-color: #ccd5f3;
    padding: 0px;
}

#case-indicator {
    spacing: 0;
    text-color: @selected-active-background;
    background-color:@selected-normal-background;
    padding: 10px 4px;
    border-radius:0px 12px 12px 0px;
}

#entry {
    spacing: 0;
    text-color: @normal-foreground;
    text-color: @selected-active-background;
    background-color:@selected-normal-background;
    padding: 10px 0px 10px 50px;
}

#prompt {
    spacing: 0;
    padding: 10px 10px;
    text-color: #1e1e2e;
    background-color: #e8c2ff;
    text-color: @selected-active-background;
    background-color:@selected-normal-background;
}
